+    << " ids_contiguous=" << (d.idsContiguous ? 1 : 0) << " dup_ids=" << d.dupIds
+    << " dup_states=" << d.dupStates << " nonfinite=" << d.nonFinite
+    << " norm_fail=" << d.normFail << " max_norm_dev=" << FormatDouble(d.maxNormDev)
+    << " dz_nonneg=" << d.dzNonNeg << " ekin_nonpos=" << d.ekinNonPos
