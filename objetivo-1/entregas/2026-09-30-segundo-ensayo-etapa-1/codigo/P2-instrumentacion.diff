diff --git a/scripts/simulation/geant4_app/include/EventAction.hh b/scripts/simulation/geant4_app/include/EventAction.hh
new file mode 100644
index 0000000..cde5ba4
--- /dev/null
+++ b/scripts/simulation/geant4_app/include/EventAction.hh
@@ -0,0 +1,81 @@
+#ifndef EVENT_ACTION_HH
+#define EVENT_ACTION_HH
+
+#include "G4StepStatus.hh"
+#include "G4ThreeVector.hh"
+#include "G4UserEventAction.hh"
+
+#include "MuonRecord.hh"
+#include "Oe1ListMode.hh"
+#include "RegionCrossing.hh"
+
+class G4Event;
+class G4Material;
+class G4Step;
+class G4VPhysicalVolume;
+class G4VProcess;
+
+// OE1 stage 1 (P2), list mode only (worker threads). Per primary muon:
+//  - BeginOfEventAction reseeds the worker engine with the key
+//    {event_id, s_tr, case_code, TAG_TR} (G4Random::setTheSeeds(key, 4)), so
+//    the transport stream depends only on (s_tr, case, id); records rng0 =
+//    FNV-1a-64 of engine->put() right after the reseed and prim_fnv, the
+//    hash of the Geant4 primary;
+//  - OnPrimaryStep / OnPlane (called by SteppingAction) accumulate the
+//    final state (step count, last process / status / volume, plane entry)
+//    and, with --muon-log full, the chord crossings of the region Z and the
+//    lateral displacement of the steps.
+//    --muon-log min still runs OnPrimaryStep on every primary step: it keeps
+//    the O(1) status bookkeeping there (step count, last process / step status
+//    / post-step volume and energy; it is needed to classify the muons that do
+//    not reach the plane) and skips only the chord / region / energy /
+//    material / lateral-displacement accumulation;
+//  - EndOfEventAction records rng1 and pushes the record into RunData.
+// Nothing here draws random numbers or queries the navigator; engine->put()
+// only reads the state.
+//
+// The pre->post chord of a step is NOT the path the muon followed: WentzelVI
+// displaces the post-step point laterally (plan correction C1). The chord
+// lengths in Z are therefore reported with the lateral displacement of the
+// steps near Z (max_lat_z_mm, sum_lat_z_mm), and max_lat_mm over all steps is a
+// diagnostic only.
+//
+// Pieces of a step of length <= 2 eps inside Z (slivers left by endpoints on a
+// navigation boundary, or a tiny step deep inside Z) enter the chord-length
+// sums (lz_m, ...: every piece is added, however short) but not `crossed`, the
+// step / entry / material / energy fields; so crossed = 1 always implies
+// n_steps_z >= 1 and a non-empty mat_in.
+class EventAction : public G4UserEventAction
+{
+ public:
+  explicit EventAction(const oe1::ListModeConfig& cfg);
+
+  void BeginOfEventAction(const G4Event* event) override;
+  void EndOfEventAction(const G4Event* event) override;
+
+  // Every step of the primary (SteppingAction, before its early returns).
+  void OnPrimaryStep(const G4Step* step);
+  // Primary entering the scoring plane (SteppingAction, before the kill);
+  // iAz/iEl are -1 outside the grid.
+  void OnPlane(int iAz, int iEl, double ekinGeV, double elDeg, double relAzDeg);
+
+ private:
+  oe1::MatCode Classify(const G4Material* mat) const;
+
+  const oe1::ListModeConfig& fCfg;
+  // The seed key must outlive setTheSeeds(): MixMaxRng keeps the pointer.
+  long fSeedKey[4] = {0, 0, 0, 0};
+  bool fWorkerNoted = false;
+
+  oe1::MuonRecord fRec;
+  // Last primary step, for the final status.
+  const G4VProcess* fLastProcess = nullptr;
+  G4StepStatus fLastStepStatus = fUndefined;
+  double fLastPostEkin = 0.0;
+  const G4VPhysicalVolume* fLastPostVolume = nullptr;
+  G4ThreeVector fLastPostPos;
+  // Continuity of Z runs across consecutive steps (entry counting).
+  oe1::EntryCounter fEntries;
+};
+
+#endif
diff --git a/scripts/simulation/geant4_app/include/MuonRecord.hh b/scripts/simulation/geant4_app/include/MuonRecord.hh
new file mode 100644
index 0000000..66e5b17
--- /dev/null
+++ b/scripts/simulation/geant4_app/include/MuonRecord.hh
@@ -0,0 +1,293 @@
+#ifndef OE1_MUON_RECORD_HH
+#define OE1_MUON_RECORD_HH
+
+#include <algorithm>
+#include <charconv>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <system_error>
+#include <vector>
+
+#include "Oe1Hash.hh"
+
+// OE1 stage 1 (P2): per-primary record of a list-mode run and the
+// <stem>_muones.csv row format. No Geant4 dependency.
+//
+// Every field has a defined default (value initialisation), so two runs
+// with identical physics produce byte-identical rows (A/A identity).
+namespace oe1 {
+
+// Final state of a primary. DET: entered the scoring plane inside the
+// 256x256 grid (counted in hist.csv). PLANE_OUT: entered the plane outside
+// the grid (not counted). WORLD_EXIT: last step reached the world boundary.
+// DECAY / MU_CAPTURE: ended by a decay process / by the mu- capture-at-rest
+// process (which also covers decay in orbit). STOPPED: kinetic energy zero
+// without one of those. OTHER: anything else. ABORTED: event aborted.
+enum class MuonStatus : int {
+  kDet = 0,
+  kPlaneOut,
+  kWorldExit,
+  kDecay,
+  kMuCapture,
+  kStopped,
+  kOther,
+  kAborted
+};
+constexpr int kNumMuonStatus = 8;
+
+inline const char* StatusName(MuonStatus s)
+{
+  switch (s) {
+    case MuonStatus::kDet: return "DET";
+    case MuonStatus::kPlaneOut: return "PLANE_OUT";
+    case MuonStatus::kWorldExit: return "WORLD_EXIT";
+    case MuonStatus::kDecay: return "DECAY";
+    case MuonStatus::kMuCapture: return "MU_CAPTURE";
+    case MuonStatus::kStopped: return "STOPPED";
+    case MuonStatus::kOther: return "OTHER";
+    case MuonStatus::kAborted: return "ABORTED";
+  }
+  return "OTHER";
+}
+
+// Material class of a step's pre-step volume: R = edifice rock,
+// A0 / A1 = material of the first / second anomaly of --region-pair,
+// AIR = G4_AIR, X = anything else. kNone = no step inside Z.
+enum class MatCode : int { kNone = 0, kRock, kA0, kA1, kAir, kOther };
+
+inline const char* MatCodeName(MatCode m)
+{
+  switch (m) {
+    case MatCode::kNone: return "";
+    case MatCode::kRock: return "R";
+    case MatCode::kA0: return "A0";
+    case MatCode::kA1: return "A1";
+    case MatCode::kAir: return "AIR";
+    case MatCode::kOther: return "X";
+  }
+  return "X";
+}
+
+struct MuonRecord {
+  // identity and random-stream evidence
+  int64_t id = -1;
+  uint64_t primFnv = 0;  // FNV-1a-64 of the Geant4 primary at BeginOfEventAction
+  uint64_t rng0 = 0;     // engine state hash right after the per-muon reseed
+  uint64_t rng1 = 0;     // engine state hash at EndOfEventAction
+
+  // detection (same condition and integers as SteppingAction / RunData)
+  int detected = 0;
+  int iel = -1;
+  int iaz = -1;
+  int inRint = -1;  // 1/0 = detected inside/outside R_int; -1 = not detected
+  bool planeReached = false;
+  double ekinPlaneGeV = 0.0;
+  double elPlaneDeg = 0.0;
+  double relAzPlaneDeg = 0.0;
+
+  // completion
+  MuonStatus status = MuonStatus::kOther;
+  std::string endProcess;  // process that defined the last primary step
+  int64_t nSteps = 0;
+  bool haveEnd = false;  // full log only
+  double endXm = 0.0, endYm = 0.0, endZm = 0.0;
+  std::string endVolume;  // volume of the last post-step point
+
+  // 3D region Z (full log and region applicable only)
+  bool deep = false;
+  double lz = 0.0, lzTrue = 0.0;
+  double lzRock = 0.0, lzA0 = 0.0, lzA1 = 0.0, lzOther = 0.0;
+  double lc = 0.0, le = 0.0;
+  double rhoLzGcm2 = 0.0;
+  int64_t nStepsZ = 0, nStepsZBothOut = 0, nEntriesZ = 0, nGrazeZ = 0;
+  MatCode matIn = MatCode::kNone, matOut = MatCode::kNone;
+  bool haveEIn = false, haveEOut = false;
+  double eInGeV = 0.0, eInLoGeV = 0.0, eInHiGeV = 0.0;
+  double eOutGeV = 0.0, eOutLoGeV = 0.0, eOutHiGeV = 0.0;
+
+  // Lateral displacement (plan correction C1). lat = |(post - pre) x dir_pre|
+  // of a primary step is the sideways offset of the post-step point from the
+  // line pre + s dir_pre; multiple scattering (WentzelVI) makes it non-zero
+  // in nearly every muon, so the pre->post chord is NOT the path that was
+  // followed. maxLatMm is a pure diagnostic over all primary steps;
+  // maxLatZMm / sumLatZMm are the largest and the summed lat over the steps
+  // "near Z" (chord meets both primitives grown by oe1::kNearZMarginM). The
+  // sum is the accumulated transverse displacement of those steps: a scale of
+  // the uncertainty of the length in Z, NOT a bound. At an incidence angle
+  // theta the length error is ~ lat / sin(theta); for a chord skimming a
+  // surface it grows like sqrt(2 R lat) (R <= 86.3 m here), so report it as
+  // <~ 2 sqrt(2 R_max lat). A chord that penetrates Z by less than
+  // max_lat_z_mm may be classified differently from the real path.
+  // nStepsNearZ counts those steps (meta only, not a column of the log).
+  double maxLatMm = 0.0;
+  double maxLatZMm = 0.0;
+  double sumLatZMm = 0.0;
+  int64_t nStepsNearZ = 0;
+};
+
+// Columns that are constant within a run (PROT:48: case, replica, list
+// fingerprint in every row).
+struct MuonRowConstants {
+  uint32_t caseCode = 0;
+  std::string geometryId;
+  int view = 0;
+  std::string variant;
+  int replica = 0;
+  std::string listSha256;
+};
+
+// What the run logged: fullLog = crossing/step accumulation on
+// (--muon-log full); regionApplicable = --region-pair given.
+struct MuonLogShape {
+  bool fullLog = true;
+  bool regionApplicable = false;
+};
+
+// 49 columns: the 47 of the first delivery followed by max_lat_z_mm and
+// sum_lat_z_mm (plan correction C1). The Python readers take the two new names
+// as optional columns (oe1_stage1_common.MUON_OPTIONAL_COLUMNS).
+inline const char* MuonCsvHeader()
+{
+  return "caso,geometry_id,view,variant,replica,list_sha256,id,prim_fnv,rng0,rng1,"
+         "detected,iel,iaz,in_rint,ekin_plane_gev,el_plane_deg,relaz_plane_deg,"
+         "status,end_process,n_steps,end_x_m,end_y_m,end_z_m,end_vol,"
+         "crossed,lz_m,lz_true_m,lz_rock_m,lz_a0_m,lz_a1_m,lz_other_m,lc_m,le_m,"
+         "rho_lz_gcm2,n_steps_z,n_steps_z_both_out,n_entries_z,n_graze_z,mat_in,"
+         "mat_out,e_in_gev,e_in_lo_gev,e_in_hi_gev,e_out_gev,e_out_lo_gev,"
+         "e_out_hi_gev,max_lat_mm,max_lat_z_mm,sum_lat_z_mm";
+}
+constexpr int kMuonCsvColumns = 49;
+
+namespace muon_csv_detail {
+
+inline void Num(std::string& out, double v)
+{
+  char buf[64];
+  const auto res = std::to_chars(buf, buf + sizeof buf, v);
+  out.append(buf, res.ptr);
+}
+
+inline void Int(std::string& out, int64_t v)
+{
+  char buf[32];
+  const auto res = std::to_chars(buf, buf + sizeof buf, v);
+  out.append(buf, res.ptr);
+}
+
+inline void Sep(std::string& out) { out.push_back(','); }
+
+}  // namespace muon_csv_detail
+
+// Appends one CSV row (with trailing LF). Empty field = not applicable or
+// not logged; see MuonCsvHeader() for the column order.
+inline void AppendMuonCsvRow(std::string& out, const MuonRowConstants& k,
+                             const MuonLogShape& shape, const MuonRecord& r)
+{
+  using namespace muon_csv_detail;
+  Int(out, static_cast<int64_t>(k.caseCode)); Sep(out);
+  out += k.geometryId; Sep(out);
+  Int(out, k.view); Sep(out);
+  out += k.variant; Sep(out);
+  Int(out, k.replica); Sep(out);
+  out += k.listSha256; Sep(out);
+  Int(out, r.id); Sep(out);
+  out += Hex16(r.primFnv); Sep(out);
+  out += Hex16(r.rng0); Sep(out);
+  out += Hex16(r.rng1); Sep(out);
+
+  Int(out, r.detected); Sep(out);
+  Int(out, r.iel); Sep(out);
+  Int(out, r.iaz); Sep(out);
+  Int(out, r.inRint); Sep(out);
+  if (r.planeReached) Num(out, r.ekinPlaneGeV);
+  Sep(out);
+  if (r.planeReached) Num(out, r.elPlaneDeg);
+  Sep(out);
+  if (r.planeReached) Num(out, r.relAzPlaneDeg);
+  Sep(out);
+
+  out += StatusName(r.status); Sep(out);
+  out += r.endProcess; Sep(out);
+  Int(out, r.nSteps); Sep(out);
+  if (shape.fullLog && r.haveEnd) Num(out, r.endXm);
+  Sep(out);
+  if (shape.fullLog && r.haveEnd) Num(out, r.endYm);
+  Sep(out);
+  if (shape.fullLog && r.haveEnd) Num(out, r.endZm);
+  Sep(out);
+  if (shape.fullLog && r.haveEnd) out += r.endVolume;
+  Sep(out);
+
+  const bool z = shape.fullLog && shape.regionApplicable;
+  if (shape.fullLog) Int(out, shape.regionApplicable ? (r.deep ? 1 : 0) : -1);
+  Sep(out);
+  const double zvals[] = {r.lz, r.lzTrue, r.lzRock, r.lzA0, r.lzA1,
+                          r.lzOther, r.lc, r.le, r.rhoLzGcm2};
+  for (const double v : zvals) {
+    if (z) Num(out, v);
+    Sep(out);
+  }
+  const int64_t zcounts[] = {r.nStepsZ, r.nStepsZBothOut, r.nEntriesZ, r.nGrazeZ};
+  for (const int64_t v : zcounts) {
+    if (z) Int(out, v);
+    Sep(out);
+  }
+  if (z) out += MatCodeName(r.matIn);
+  Sep(out);
+  if (z) out += MatCodeName(r.matOut);
+  Sep(out);
+  const double ein[] = {r.eInGeV, r.eInLoGeV, r.eInHiGeV};
+  for (const double v : ein) {
+    if (z && r.haveEIn) Num(out, v);
+    Sep(out);
+  }
+  const double eout[] = {r.eOutGeV, r.eOutLoGeV, r.eOutHiGeV};
+  for (const double v : eout) {
+    if (z && r.haveEOut) Num(out, v);
+    Sep(out);
+  }
+  if (shape.fullLog && r.nSteps > 0) Num(out, r.maxLatMm);
+  Sep(out);
+  // Lateral displacement of the steps near Z: like the crossing fields, only
+  // with the full log and a region (a muon without a near step logs 0).
+  if (z) Num(out, r.maxLatZMm);
+  Sep(out);
+  if (z) Num(out, r.sumLatZMm);
+  out.push_back('\n');
+}
+
+// Sorts by id and checks that the ids are exactly 0..n-1, each once.
+inline bool SortAndCheckIds(std::vector<MuonRecord>& recs, std::size_t n)
+{
+  std::sort(recs.begin(), recs.end(),
+            [](const MuonRecord& a, const MuonRecord& b) { return a.id < b.id; });
+  if (recs.size() != n) return false;
+  for (std::size_t i = 0; i < recs.size(); ++i) {
+    if (recs[i].id != static_cast<int64_t>(i)) return false;
+  }
+  return true;
+}
+
+// Histogram [iel * nAz + iaz] rebuilt from DET rows only. Rows with an
+// out-of-range bin are counted in badBins and skipped.
+inline std::vector<uint64_t> RebuildHistogram(const std::vector<MuonRecord>& recs,
+                                              int nEl, int nAz, std::size_t& badBins)
+{
+  std::vector<uint64_t> h(static_cast<std::size_t>(nEl) * static_cast<std::size_t>(nAz), 0);
+  badBins = 0;
+  for (const auto& r : recs) {
+    if (r.status != MuonStatus::kDet) continue;
+    if (r.iel < 0 || r.iel >= nEl || r.iaz < 0 || r.iaz >= nAz) {
+      ++badBins;
+      continue;
+    }
+    h[static_cast<std::size_t>(r.iel) * static_cast<std::size_t>(nAz) +
+      static_cast<std::size_t>(r.iaz)] += 1;
+  }
+  return h;
+}
+
+}  // namespace oe1
+
+#endif
diff --git a/scripts/simulation/geant4_app/include/Oe1Cli.hh b/scripts/simulation/geant4_app/include/Oe1Cli.hh
new file mode 100644
index 0000000..ead11b3
--- /dev/null
+++ b/scripts/simulation/geant4_app/include/Oe1Cli.hh
@@ -0,0 +1,87 @@
+#ifndef OE1_CLI_HH
+#define OE1_CLI_HH
+
+#include <cstdint>
+#include <ostream>
+#include <string>
+
+#include "GeometryConfig.hh"
+#include "Oe1ListMode.hh"
+#include "PrimaryList.hh"
+#include "RoiMask.hh"
+
+// OE1 stage 1 (P2): command line of the new modes. No Geant4 dependency.
+//
+// If any OE1 flag appears, the WHOLE command line is parsed strictly: an
+// unknown token, a missing or malformed value, a repeated flag, a P0
+// geometry-diagnostic flag or a flag not allowed in the selected mode is an
+// error (main exits 2). Without OE1 flags nothing here runs and the legacy
+// parser alone decides, exactly as before.
+namespace oe1 {
+
+enum class CliMode { kNone, kList, kWrite, kCheck };
+
+struct CliOptions {
+  CliMode mode = CliMode::kNone;
+
+  // Legacy value flags, as validated by the strict parser.
+  std::string geometry, tables, out;
+  int view = -1;
+  uint64_t seed = 0;
+  long long events = -1;
+  int threads = 1;
+
+  // List mode (--primaries).
+  std::string primaries, primariesSha256, roiMask, roiMaskSha256, variant;
+  uint64_t transportSeed = 0;
+  uint32_t caseCode = 0;
+  int replica = -1;
+  // --region-pair I,J (conduit, dense_body|cavity) or --region-pair none. With
+  // neither, a geometry with two or more anomalies is an argument error
+  // (ConfigureListMode returns 2): the pair must be chosen or waived on purpose.
+  bool haveRegionPair = false;
+  bool regionPairNone = false;
+  int regionFirst = -1, regionSecond = -1;
+  MuonLogLevel logLevel = MuonLogLevel::kFull;
+
+  // Generation (--write-primaries) and check (--check-primaries) modes.
+  std::string writeOut;
+  std::string checkFile;
+};
+
+// True if any OE1 stage-1 flag appears anywhere on the command line.
+bool AnyStage1Flag(int argc, char** argv);
+
+// Strict parse; false with a message on any violation.
+bool ParseStage1(int argc, char** argv, CliOptions& opt, std::string& err);
+
+void PrintStage1Usage(std::ostream& os, const char* prog);
+
+// List mode, once the geometry JSON is loaded: checks the list sidecar
+// against the geometry and the command line, builds the region Z and fills
+// `out` (runtime provenance is added later by main). Returns 0 on success,
+// 1 on an input mismatch, 2 on an argument that is invalid for this geometry.
+// Returns 2 also when the geometry has two or more anomalies and neither
+// --region-pair I,J nor --region-pair none was given (plan W2): a forgotten
+// pair would silently turn every crossing field into "not applicable".
+int ConfigureListMode(const CliOptions& opt, const GeometryConfig& cfg,
+                      const PrimaryList& list, const RoiMask& mask,
+                      ListModeConfig& out, std::string& err);
+
+// List mode: records in `out` the SHA-256 of this executable (/proc/self/exe,
+// as --write-primaries does for its sidecar), of the geometry JSON (opt.geometry)
+// and of the three generator table files (row_weights_30d.txt, p_cdf.txt and
+// meta.json of opt.tables). False with a message when a file cannot be read.
+bool RecordProvenance(const CliOptions& opt, ListModeConfig& out, std::string& err);
+
+// List mode, before the run manager exists: --out must be an existing,
+// writable directory and none of the outputs of this run (<stem>_hist.csv,
+// <stem>.meta.json, <stem>_muones.csv, <stem>_muones.csv.part) may exist, so
+// a transport is never started that would overwrite a previous result or
+// fail to write its own. `stem` is <geometry_id>_view<k>. Returns false with
+// a message otherwise.
+bool PreflightOutputs(const std::string& outDir, const std::string& stem, std::string& err);
+
+}  // namespace oe1
+
+#endif
diff --git a/scripts/simulation/geant4_app/include/Oe1Hash.hh b/scripts/simulation/geant4_app/include/Oe1Hash.hh
new file mode 100644
index 0000000..188e93e
--- /dev/null
+++ b/scripts/simulation/geant4_app/include/Oe1Hash.hh
@@ -0,0 +1,111 @@
+#ifndef OE1_HASH_HH
+#define OE1_HASH_HH
+
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <string>
+#include <vector>
+
+// OE1 stage 1 (P2): FNV-1a-64 helpers. No Geant4 dependency.
+//
+// Multi-byte values are always fed in little-endian byte order, independent
+// of the host, so every hash below can be reproduced offline, e.g. in Python
+// with struct.pack('<q', ...), struct.pack('<d', ...), struct.pack('<i', ...).
+namespace oe1 {
+
+constexpr uint64_t kFnvOffsetBasis = 14695981039346656037ULL;  // 0xcbf29ce484222325
+constexpr uint64_t kFnvPrime = 1099511628211ULL;               // 0x00000100000001b3
+
+class Fnv1a64
+{
+ public:
+  void Bytes(const void* data, std::size_t n)
+  {
+    const auto* p = static_cast<const unsigned char*>(data);
+    for (std::size_t i = 0; i < n; ++i) {
+      fHash ^= static_cast<uint64_t>(p[i]);
+      fHash *= kFnvPrime;
+    }
+  }
+
+  void U64(uint64_t v)
+  {
+    unsigned char b[8];
+    for (int i = 0; i < 8; ++i) b[i] = static_cast<unsigned char>(v >> (8 * i));
+    Bytes(b, 8);
+  }
+
+  void I64(int64_t v) { U64(static_cast<uint64_t>(v)); }
+
+  void I32(int32_t v)
+  {
+    const auto u = static_cast<uint32_t>(v);
+    unsigned char b[4];
+    for (int i = 0; i < 4; ++i) b[i] = static_cast<unsigned char>(u >> (8 * i));
+    Bytes(b, 4);
+  }
+
+  // IEEE-754 binary64 bit pattern, little-endian (signed zeros and NaN
+  // payloads are hashed as stored).
+  void F64(double v)
+  {
+    uint64_t bits = 0;
+    std::memcpy(&bits, &v, sizeof bits);
+    U64(bits);
+  }
+
+  uint64_t Value() const { return fHash; }
+
+ private:
+  uint64_t fHash = kFnvOffsetBasis;
+};
+
+inline uint64_t Fnv1a64Of(const std::string& bytes)
+{
+  Fnv1a64 h;
+  h.Bytes(bytes.data(), bytes.size());
+  return h.Value();
+}
+
+// Hash of a CLHEP engine state as returned by HepRandomEngine::put() (each
+// word as a little-endian uint64). Reading put() consumes no random numbers.
+inline uint64_t HashEngineWords(const std::vector<unsigned long>& words)
+{
+  Fnv1a64 h;
+  for (const unsigned long w : words) h.U64(static_cast<uint64_t>(w));
+  return h.Value();
+}
+
+// 16 lowercase hex digits, zero padded.
+inline std::string Hex16(uint64_t v)
+{
+  static const char* digits = "0123456789abcdef";
+  std::string s(16, '0');
+  for (int i = 15; i >= 0; --i) {
+    s[static_cast<std::size_t>(i)] = digits[v & 0xFU];
+    v >>= 4;
+  }
+  return s;
+}
+
+// Parses exactly 16 hex digits (either case). Returns false otherwise.
+inline bool ParseHex16(const std::string& s, uint64_t& out)
+{
+  if (s.size() != 16) return false;
+  uint64_t v = 0;
+  for (const char c : s) {
+    int d = -1;
+    if (c >= '0' && c <= '9') d = c - '0';
+    else if (c >= 'a' && c <= 'f') d = c - 'a' + 10;
+    else if (c >= 'A' && c <= 'F') d = c - 'A' + 10;
+    if (d < 0) return false;
+    v = (v << 4) | static_cast<uint64_t>(d);
+  }
+  out = v;
+  return true;
+}
+
+}  // namespace oe1
+
+#endif
diff --git a/scripts/simulation/geant4_app/include/Oe1ListMode.hh b/scripts/simulation/geant4_app/include/Oe1ListMode.hh
new file mode 100644
index 0000000..9772ab2
--- /dev/null
+++ b/scripts/simulation/geant4_app/include/Oe1ListMode.hh
@@ -0,0 +1,253 @@
+#ifndef OE1_LIST_MODE_HH
+#define OE1_LIST_MODE_HH
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "GeometryConfig.hh"
+#include "PrimaryList.hh"
+#include "RegionCrossing.hh"
+#include "RoiMask.hh"
+
+// OE1 stage 1 (P2): configuration of a list-mode run (--primaries), built
+// once in main() and shared read-only by the actions. No Geant4 dependency.
+namespace oe1 {
+
+// Fourth word of the MixMax seed keys. Geant4's own per-event reseed uses
+// (0, 0, s2, s1), so a non-zero tag keeps these streams disjoint from it.
+constexpr uint32_t kTagTransport = 0x4F455431U;  // transport, per muon
+constexpr uint32_t kTagSource = 0x4F455331U;     // source list generation
+
+constexpr double kRegionEpsM = 1.0e-6;  // tangency band (deep vs graze)
+
+// Run manager class a list-mode run must report (one worker thread of the
+// task-based run manager, as in the pilot). Anything else is an error flag.
+constexpr const char* kExpectedRunManager = "G4TaskRunManager";
+
+enum class MuonLogLevel { kFull, kMin };
+
+struct ListModeConfig {
+  // Inputs (owned by main; outlive the run manager).
+  const PrimaryList* list = nullptr;
+  const RoiMask* mask = nullptr;
+  std::string listFile;   // file name only (outputs carry no paths)
+  std::string maskFile;
+
+  // Identity of the run.
+  std::string geometryId;
+  int view = 0;
+  std::string variant;  // "A" or "B"
+  uint32_t caseCode = 0;
+  int replica = 0;
+
+  // Seeds: per-muon transport key {event_id, transportSeed, caseCode,
+  // kTagTransport}; the master keeps setTheSeed(masterSeedCli % 2147483647).
+  uint64_t transportSeed = 0;
+  uint64_t masterSeedCli = 0;
+  long masterSeedApplied = 0;
+
+  // Runtime provenance, filled in main() once the run manager exists.
+  std::string runManagerClass;
+  std::string masterEngine;
+  int threadsCli = 1;
+
+  // Input provenance recorded in the meta (RecordProvenance, Oe1Cli.cc): the
+  // SHA-256 of this executable (/proc/self/exe), of the geometry JSON and of
+  // the three generator table files, so a result can be tied to the exact
+  // binary and inputs that produced it. File names only, never paths.
+  std::string binarySha256;
+  std::string geometryFile;
+  std::string geometrySha256;
+  std::vector<std::pair<std::string, std::string>> tableSha256;  // (file name, sha256)
+
+  MuonLogLevel logLevel = MuonLogLevel::kFull;
+
+  // 3D region Z from --region-pair (not applicable when absent or "none").
+  bool regionApplicable = false;
+  bool regionExplicitNone = false;  // --region-pair none: no region on purpose
+  int geometryAnomalies = 0;  // anomalies in the catalog geometry
+  int regionFirst = -1;   // conduit
+  int regionSecond = -1;  // dense_body or cavity
+  std::string regionFirstKind;
+  std::string regionSecondKind;
+  RegionZ region;
+  // Material names as built by DetectorConstruction (same in A and B).
+  std::string rockMaterial = "standard_rock";
+  std::string firstMaterial;   // "anomaly_<first>_mat"
+  std::string secondMaterial;  // "anomaly_<second>_mat"
+};
+
+// Builds Z = cylinder(anomaly i) AND ellipsoid/sphere(anomaly j) from the
+// catalog primitives (world frame, metres). Returns false with a message if
+// the indices or kinds are invalid.
+inline bool BuildRegionFromConfig(const GeometryConfig& cfg, int i, int j, double eps,
+                                  RegionZ& out, std::string& err)
+{
+  const int n = static_cast<int>(cfg.anomalies.size());
+  if (i < 0 || j < 0 || i >= n || j >= n || i == j) {
+    err = "--region-pair " + std::to_string(i) + "," + std::to_string(j) +
+          " does not name two distinct anomalies (geometry has " + std::to_string(n) + ")";
+    return false;
+  }
+  const AnomalyConfig& c = cfg.anomalies[static_cast<std::size_t>(i)];
+  const AnomalyConfig& e = cfg.anomalies[static_cast<std::size_t>(j)];
+  if (c.kind != "conduit") {
+    err = "--region-pair: anomaly " + std::to_string(i) + " is '" + c.kind +
+          "', expected 'conduit'";
+    return false;
+  }
+  EllipsoidPrim ell;
+  if (e.kind == "dense_body") {
+    ell = {e.cx, e.cy, e.cz, e.ax, e.ay, e.az};
+  }
+  else if (e.kind == "cavity") {
+    ell = {e.cx, e.cy, e.cz, e.radius, e.radius, e.radius};
+  }
+  else {
+    err = "--region-pair: anomaly " + std::to_string(j) + " is '" + e.kind +
+          "', expected 'dense_body' or 'cavity'";
+    return false;
+  }
+  const CylinderPrim cyl{c.cx, c.cy, c.radius, c.z0, c.z1};
+  out = RegionZ(cyl, ell, eps);
+  return true;
+}
+
+// ---------------------------------------------------------------------------
+// --variant against the geometry that was actually built (plan S2).
+//
+// The master RunAction records a geometry signature: one "name:SolidType:Material"
+// entry per physical volume (SolidType = G4VSolid::GetEntityType()). DetectorConstruction
+// builds each anomaly as its plain primitive in variant A (conduit G4Tubs, dense body
+// G4Ellipsoid, cavity G4Orb) and, in variant B, as (anomaly intersect edifice) minus every
+// LATER anomaly that overlaps it. For a region pair (conduit i, ellipsoid j) whose
+// primitives overlap, B therefore builds the EARLIER of the two as a G4SubtractionSolid
+// (geo-train-06: anomaly_0 is a G4Tubs in A and a G4SubtractionSolid in B).
+enum class VariantCheck { kNotChecked, kOk, kMismatch };
+
+inline const char* PrimitiveSolidType(const std::string& kind)
+{
+  if (kind == "conduit") return "G4Tubs";
+  if (kind == "dense_body") return "G4Ellipsoid";
+  if (kind == "cavity") return "G4Orb";
+  return "";
+}
+
+// Solid type of "anomaly_<index>" in the signature entries; empty if absent.
+inline std::string SignatureSolid(const std::vector<std::string>& volumes, int index)
+{
+  const std::string prefix = "anomaly_" + std::to_string(index) + ":";
+  for (const std::string& entry : volumes) {
+    if (entry.compare(0, prefix.size(), prefix) != 0) continue;
+    const std::size_t end = entry.find(':', prefix.size());
+    return entry.substr(prefix.size(),
+                        end == std::string::npos ? std::string::npos : end - prefix.size());
+  }
+  return std::string();
+}
+
+// `zBoxNonEmpty` = the bounding boxes of the two primitives overlap (variant B
+// only subtracts overlapping anomalies; without an overlap it cannot be told
+// from A and is reported as not checked).
+inline VariantCheck CheckVariantAgainstSignature(const std::string& variant, int first, int second,
+                                                 const std::string& firstKind,
+                                                 const std::string& secondKind, bool zBoxNonEmpty,
+                                                 const std::vector<std::string>& volumes,
+                                                 std::string& why)
+{
+  why.clear();
+  if (variant == "A") {
+    const int idx[2] = {first, second};
+    const std::string* kind[2] = {&firstKind, &secondKind};
+    for (int k = 0; k < 2; ++k) {
+      const std::string want = PrimitiveSolidType(*kind[k]);
+      const std::string got = SignatureSolid(volumes, idx[k]);
+      if (got != want) {
+        why = "--variant A expects anomaly_" + std::to_string(idx[k]) + " to be a " + want +
+              " (plain primitive) but the geometry built '" + (got.empty() ? "no such volume" : got) +
+              "'";
+        return VariantCheck::kMismatch;
+      }
+    }
+    return VariantCheck::kOk;
+  }
+  if (variant == "B") {
+    if (!zBoxNonEmpty) {
+      why = "the two primitives do not overlap: variant B cannot be told from A";
+      return VariantCheck::kNotChecked;
+    }
+    const int earlier = std::min(first, second);
+    const std::string got = SignatureSolid(volumes, earlier);
+    if (got != "G4SubtractionSolid") {
+      why = "--variant B expects anomaly_" + std::to_string(earlier) +
+            " to be a G4SubtractionSolid but the geometry built '" +
+            (got.empty() ? "no such volume" : got) + "'";
+      return VariantCheck::kMismatch;
+    }
+    return VariantCheck::kOk;
+  }
+  why = "--variant '" + variant + "' is neither A nor B";
+  return VariantCheck::kMismatch;
+}
+
+// ---------------------------------------------------------------------------
+// The run checks that need no transport (plan S3).
+//
+// The run manager class is known as soon as the manager exists and the geometry
+// signature as soon as runManager->Initialize() has built the geometry, so
+// main() evaluates both right after Initialize() and, when one fails, exits
+// with kExitRunCheckFailed BEFORE BeamOn: no transport runs and no evidence
+// file is written for a run that cannot be valid. RunAction evaluates the very
+// same function again at the end of the run (second line of defence: it puts
+// the codes into oe1_etapa1.errors and the process still exits 4).
+//
+// Exit codes of a list-mode run (the full order is in the header of
+// muography_sim.cc): 2 strict command line and --region-pair rule, 1 unusable
+// input, then 4 for a failure of this function after runManager->Initialize()
+// (nothing ran), then BeamOn, then 4 for a run check that failed at the end of
+// the run (the two checks of this function once more among them), else 0.
+constexpr int kExitRunCheckFailed = 4;
+constexpr const char* kErrRunManagerNotTask = "run_manager_not_task";
+constexpr const char* kErrVariantMismatch = "variant_geometry_mismatch";
+
+struct PreRunReport {
+  std::vector<std::string> errors;    // error codes, as in RunData and oe1_etapa1.errors
+  std::vector<std::string> messages;  // one readable line per error
+  VariantCheck variantCheck = VariantCheck::kNotChecked;
+  std::string variantWhy;             // also the meta's geometry_signature.variant_check_note
+  bool Ok() const { return errors.empty(); }
+};
+
+// `lm.runManagerClass` must already hold the class of the run manager in use;
+// `signature` is the geometry signature of the geometry that was built (one
+// "name:SolidType:Material" entry per physical volume, see above). The variant
+// is only checked when a region pair names the anomalies whose solids tell A
+// from B (lm.regionApplicable).
+inline PreRunReport CheckBeforeTransport(const ListModeConfig& lm,
+                                         const std::vector<std::string>& signature)
+{
+  PreRunReport r;
+  if (lm.runManagerClass != kExpectedRunManager) {
+    r.errors.emplace_back(kErrRunManagerNotTask);
+    r.messages.push_back("the run manager is '" + lm.runManagerClass + "', expected '" +
+                         std::string(kExpectedRunManager) + "'");
+  }
+  if (lm.regionApplicable) {
+    r.variantCheck = CheckVariantAgainstSignature(lm.variant, lm.regionFirst, lm.regionSecond,
+                                                  lm.regionFirstKind, lm.regionSecondKind,
+                                                  lm.region.ZBoxNonEmpty(), signature, r.variantWhy);
+    if (r.variantCheck == VariantCheck::kMismatch) {
+      r.errors.emplace_back(kErrVariantMismatch);
+      r.messages.push_back(r.variantWhy);
+    }
+  }
+  return r;
+}
+
+}  // namespace oe1
+
+#endif
