+void TestFilesAndLoad()
+{
+  TempDir dir("list");
+  const auto recs = MakeRecords(64, 3);
+  const std::string path = (dir.path / "geo-train-06_v0_r1_s2026092901.primarios.csv").string();
+  std::string err;
+
+  CHECK(oe1::WritePrimaryCsv(path, recs, err));
+  const std::string content = ReadAll(path);
+  CHECK(content == MakeText(recs));
+  // Exclusive create: a second write must fail and leave the file untouched.
+  CHECK(!oe1::WritePrimaryCsv(path, MakeRecords(3, 9), err));
+  CHECK(ReadAll(path) == content);
+  CHECK(err.find("cannot create") != std::string::npos);
+
+  std::vector<oe1::PrimaryRecord> back;
+  oe1::ListDefects d;
+  std::string sha;
+  CHECK(oe1::ReadPrimaryFile(path, back, d, sha));
+  CHECK_EQ_STR(sha, oe1::Sha256Hex(content));
+  CHECK(back.size() == recs.size());
+  oe1::ValidatePrimaryRecords(back, d);
+  CHECK(d.Clean());
+  CHECK(oe1::CanonicalFnv(back) == oe1::CanonicalFnv(recs));
+  CHECK(!oe1::ReadPrimaryFile((dir.path / "nope.csv").string(), back, d, sha));
+
+  const std::uint64_t canon = oe1::CanonicalFnv(recs);
+  CHECK(oe1::WriteSidecar(oe1::SidecarPath(path), MakeProvenance(canon, sha), recs.size(), err));
+  const std::string sidecarBytes = ReadAll(oe1::SidecarPath(path));
+  CHECK(!oe1::WriteSidecar(oe1::SidecarPath(path), MakeProvenance(canon, sha), 1, err));
+  CHECK(ReadAll(oe1::SidecarPath(path)) == sidecarBytes);  // refused to overwrite
+
+  oe1::ListSidecar sc;
+  CHECK(oe1::ReadSidecar(oe1::SidecarPath(path), sc, err));
+  CHECK_EQ_STR(sc.format, "oe1-primarios/1");
+  CHECK_EQ_STR(sc.geometryId, "geo-train-06");
+  CHECK(sc.view == 0 && sc.caseCode == 6 && sc.replica == 1 && sc.n == 64);
+  CHECK(sc.haveBaseRadius && sc.baseRadiusM == 509.7);
+  CHECK(sc.sourceSeed == 2026092901LL);
+  CHECK(sc.haveCanonFnv && sc.canonFnv == canon);
+  CHECK_EQ_STR(sc.fileSha256, sha);
+  {
+    const nlohmann::json j = ReadJson(oe1::SidecarPath(path));
+    CHECK(j.at("rng").at("key") == nlohmann::json::array({2026092901ULL, 6, 0, 0x4F455331U}));
+    CHECK(j.at("rng").at("draws_per_primary") == 7);
+    CHECK(j.at("start_radius_m") == 1809.7);
+    CHECK(j.at("canon_fnv1a64") == oe1::Hex16(canon));
+    CHECK(j.at("binary_sha256") == std::string(64, 'b'));
+  }
+
+  // Load: success.
+  {
+    oe1::PrimaryList pl;
+    CHECK(pl.Load(path, sha, err));
+    CHECK(pl.Size() == 64);
+    CHECK(pl.CanonFnv() == canon);
+    CHECK_EQ_STR(pl.FileSha256(), sha);
+    bool same = true;
+    for (std::size_t k = 0; k < 64; ++k) same = same && SameRecord(pl.At(k), recs[k]);
+    CHECK(same);
+    oe1::PrimaryList pl2;  // empty expected sha = no check (only the sidecar)
+    CHECK(pl2.Load(path, "", err));
+  }
+  // Load: wrong expected SHA-256.
+  {
+    oe1::PrimaryList pl;
+    CHECK(!pl.Load(path, std::string(64, '0'), err));
+    CHECK(err.find("SHA-256 mismatch") != std::string::npos);
+  }
+  // Load: tampered sidecar variants.
+  const nlohmann::json base = ReadJson(oe1::SidecarPath(path));
+  const auto expectFail = [&](const char* what, nlohmann::json j, const char* expected) {
+    WriteJson(oe1::SidecarPath(path), j);
+    oe1::PrimaryList pl;
+    std::string e2;
+    const bool ok = pl.Load(path, sha, e2);
+    ++g_checks;
+    if (ok || e2.find(expected) == std::string::npos) {
+      oe1test::Fail(__FILE__, __LINE__,
+                    std::string("sidecar variant '") + what + "': ok=" + (ok ? "1" : "0") +
+                        " err='" + e2 + "'");
+    }
+  };
+  {
+    auto j = base; j["n"] = 65;
+    expectFail("n", j, "sidecar n=65");
+    j = base; j["canon_fnv1a64"] = oe1::Hex16(canon ^ 1ULL);
+    expectFail("canon", j, "canon_fnv1a64");
+    j = base; j["file_sha256"] = std::string(64, 'f');
+    expectFail("file_sha256", j, "file_sha256");
+    j = base; j["format"] = "oe1-primarios/2";
+    expectFail("format", j, "sidecar format");
+    j = base; j.erase("geometry_id");
+    expectFail("geometry_id", j, "lacks geometry_id");
+    j = base; j.erase("base_radius_m");
+    expectFail("base_radius_m", j, "lacks geometry_id");
+    j = base; j.erase("case_code");
+    expectFail("case_code", j, "lacks geometry_id");
+    j = base; j["canon_fnv1a64"] = "zz";
+    expectFail("canon not hex", j, "16 hex digits");
+    WriteAll(oe1::SidecarPath(path), "{ not json");
+    oe1::PrimaryList pl;
+    CHECK(!pl.Load(path, sha, err));
+    CHECK(err.find("invalid sidecar") != std::string::npos);
+    fs::remove(oe1::SidecarPath(path));
+    CHECK(!pl.Load(path, sha, err));
+    CHECK(err.find("missing sidecar") != std::string::npos);
+    WriteJson(oe1::SidecarPath(path), base);
+  }
+  // Load: list altered after the sidecar was written.
+  {
+    std::string altered = content;
+    const std::size_t pos = altered.find(',', altered.find('\n')) + 1;
+    altered[pos] = altered[pos] == '1' ? '2' : '1';
+    WriteAll(path, altered);
+    oe1::PrimaryList pl;
+    CHECK(!pl.Load(path, "", err));  // sidecar file_sha256 / canon no longer match
+    WriteAll(path, content);
+    CHECK(pl.Load(path, sha, err));
+  }
+  // Load: list with defects, and an empty list, are rejected.
+  {
+    auto bad = recs;
+    bad[10].dz = -bad[10].dz;
+    const std::string p2 = WriteListAndSidecar(dir.path, "defect.csv", bad);
+    oe1::PrimaryList pl;
+    CHECK(!pl.Load(p2, "", err));
+    CHECK(err.find("defects") != std::string::npos);
+    const std::string p3 = (dir.path / "empty.csv").string();
+    WriteAll(p3, std::string(oe1::kPrimaryListHeader) + "\n");
+    CHECK(!pl.Load(p3, "", err));
+  }
+}
+
+void TestCheckPrimaries()
+{
+  TempDir dirA("chkA"), dirB("chkB");
+  const auto recs = MakeRecords(200, 5);
+  const std::string name = "geo-train-06_v0_r2_s2026092902.primarios.csv";
+  const std::string pa = WriteListAndSidecar(dirA.path, name, recs);
+  const std::string pb = WriteListAndSidecar(dirB.path, name, recs);
+  // Sidecars of two binaries differ only in binary_sha256; here identical.
+  std::ostringstream oa, ea, ob, eb;
+  CHECK(oe1::RunCheckPrimaries(pa, oa, ea) == 0);
+  CHECK(oe1::RunCheckPrimaries(pb, ob, eb) == 0);
+  CHECK(oa.str() == ob.str());  // identical output for the same list in another folder
+  const std::string line = oa.str();
+  CHECK(!line.empty() && line.back() == '\n' &&
+        std::count(line.begin(), line.end(), '\n') == 1);  // exactly one summary line
+  CHECK(line.rfind("OE1-CHECK-PRIMARIES file=" + name + " n=200 ", 0) == 0);
+  CHECK(line.find("status=OK") != std::string::npos);
+  CHECK(line.find("sidecar_fnv_match=1") != std::string::npos);
+  CHECK(line.find("sidecar_sha_match=1") != std::string::npos);
+  CHECK(line.find(oe1::Hex16(oe1::CanonicalFnv(recs))) != std::string::npos);
+  CHECK(ea.str().empty());
+
+  // A defect anywhere gives a non-zero status and a DEFECT line.
+  {
+    auto bad = recs;
+    bad[50].ekin_gev = -2.0;
+    const std::string pd = WriteListAndSidecar(dirA.path, "bad.csv", bad);
+    std::ostringstream o, e;
+    CHECK(oe1::RunCheckPrimaries(pd, o, e) == 1);
+    CHECK(o.str().find("status=DEFECT") != std::string::npos);
+    CHECK(o.str().find("ekin_nonpos=1") != std::string::npos);
+  }
+  // Missing sidecar, unreadable list.
+  {
+    fs::remove(oe1::SidecarPath(pa));
+    std::ostringstream o, e;
+    CHECK(oe1::RunCheckPrimaries(pa, o, e) == 1);
+    CHECK(o.str().find("sidecar=missing") != std::string::npos);
+    CHECK(o.str().find("status=DEFECT") != std::string::npos);
+    std::ostringstream o2, e2;
+    CHECK(oe1::RunCheckPrimaries((dirA.path / "absent.csv").string(), o2, e2) == 1);
+    CHECK(o2.str().find("status=UNREADABLE") != std::string::npos);
+  }
+  // Sidecar that disagrees with the list content.
+  {
+    const std::string path = WriteListAndSidecar(dirA.path, "mismatch.csv", recs);
+    auto j = ReadJson(oe1::SidecarPath(path));
+    j["n"] = 199;
+    fs::remove(oe1::SidecarPath(path));
+    WriteJson(oe1::SidecarPath(path), j);
+    std::ostringstream o, e;
+    CHECK(oe1::RunCheckPrimaries(path, o, e) == 1);
+    CHECK(o.str().find("status=DEFECT") != std::string::npos);
+  }
+}
+
+}  // namespace
+
+int main()
+{
+  struct Step {
+    const char* name;
+    void (*fn)();
+  };
+  const Step steps[] = {{"SHA-256 vectors, boundaries, file hashing", TestSha256},
+                        {"FNV-1a-64, hex helpers, engine-state hash", TestHashHelpers},
+                        {"to_chars / from_chars exact round trip of doubles", TestNumberRoundTrip},
+                        {"canonical FNV of a list", TestCanonicalHash},
+                        {"validation: every defect class is detected", TestValidation},
+                        {"files: exclusive create, sidecar, PrimaryList::Load", TestFilesAndLoad},
+                        {"--check-primaries summary line and status", TestCheckPrimaries}};
+  for (const Step& s : steps) {
+    const int before = g_fail;
+    s.fn();
+    std::printf("%-4s %s\n", g_fail == before ? "PASS" : "FAIL", s.name);
+  }
+  std::printf("test_primary_list: %d checks, %d failed\n", g_checks, g_fail);
+  return g_fail == 0 ? 0 : 1;
+}
diff --git a/scripts/simulation/geant4_app/tests/test_region_crossing.cc b/scripts/simulation/geant4_app/tests/test_region_crossing.cc
new file mode 100644
index 0000000..a43ce66
--- /dev/null
+++ b/scripts/simulation/geant4_app/tests/test_region_crossing.cc
@@ -0,0 +1,953 @@
+// OE1 stage 1 (P2): tests C1-C9 (+extras) and V of the exact chord/region
+// intersection in include/RegionCrossing.hh. Standalone (no Geant4), built
+// and run by tests/build_tests.sh with the production flags (-O3 -DNDEBUG)
+// and with -fsanitize=address,undefined.
+//
+// Region Z of geo-train-06 = conduit (cylinder) AND dense body (ellipsoid),
+// original catalog primitives, world frame, metres. References used here are
+// independent of the code under test: closed-form chord lengths in long
+// double, the director's exact vertical-length formula
+// (herramientas/validar_volumen_oe1.py:18-25), plain bisection on the
+// membership predicate, and the volume computed by the director
+// (83,663.70318 m^3, evidencias/volumen-independiente-geo-train-06.json).
+// Test R1 (1e5 random segments against an independent numpy implementation
+// and a dense-sampling oracle) lives in tests/crossing_reference.py and uses
+// tests/crossing_eval.cc.
+//
+// Usage: test_region_crossing [--fast] [--catalog DIR]
+//   --fast     coarser parallel-line grids for test V (sanitizer builds)
+//   --catalog  directory with geo-train-06.json (checks BuildRegionFromConfig)
+//
+// Tolerances: absolute 1e-9 m for lengths and points (the plan's acceptance).
+// For the reversal test C9 the plan asks 1e-12 relative; a length built from
+// coordinates of size |a|, |b| cannot be reproduced better than the rounding
+// of those coordinates (near-tangent chords amplify it), so the test uses
+// 1e-12 * max(len) + 128 u (|a| + |b|) with u = 2^-53. The absolute accuracy
+// (against a long-double evaluation of the same algorithm, worst case 1.3e-11 m
+// over 1e5 segments up to 5 km long) is far inside the 1e-9 m acceptance.
+// The volume test V uses 1 m^3 as in the plan; with --fast (the sanitizer build,
+// coarser grids) it uses 2 m^3. These deviations from the plan's literal numbers,
+// and the coordinate-scaled tolerance of R1, are listed in the
+// "deviations_from_plan" entry of pruebas-cruces.json (tests/build_tests.sh).
+// Test nearZ checks the "near Z" neighbourhood (1 m around both primitives) that
+// selects the steps whose lateral displacement is summed (plan correction C1).
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <string>
+#include <vector>
+
+#include "GeometryConfig.hh"
+#include "Oe1ListMode.hh"
+#include "RegionCrossing.hh"
+#include "check.hh"
+
+namespace {
+
+using oe1test::Fail;
+using oe1test::g_checks;
+using oe1test::g_fail;
+
+using oe1::CrossingResult;
+using oe1::CylinderPrim;
+using oe1::EllipsoidPrim;
+using oe1::RegionZ;
+using oe1::Vec3;
+using LD = long double;
+
+constexpr CylinderPrim kCyl{20.3, -24.5, 21.0, 0.0, 340.0};
+constexpr EllipsoidPrim kEll{32.2, -74.1, 137.8, 72.9, 61.6, 64.6};
+constexpr double kEps = 1.0e-6;
+constexpr double kAbsTol = 1.0e-9;  // plan: +-1e-9 m
+constexpr double kPi = 3.14159265358979323846;
+constexpr double kUnitRoundoff = 1.1102230246251565e-16;  // 2^-53
+
+const RegionZ& Region()
+{
+  static const RegionZ z(kCyl, kEll, kEps);
+  return z;
+}
+
+double Sq(double v) { return v * v; }
+LD SqL(LD v) { return v * v; }
+
+Vec3 Add(const Vec3& a, const Vec3& b) { return {a.x + b.x, a.y + b.y, a.z + b.z}; }
+Vec3 Sub(const Vec3& a, const Vec3& b) { return {a.x - b.x, a.y - b.y, a.z - b.z}; }
+Vec3 Scale(const Vec3& a, double s) { return {a.x * s, a.y * s, a.z * s}; }
+Vec3 Lerp(const Vec3& a, const Vec3& b, double t) { return Add(a, Scale(Sub(b, a), t)); }
+double Norm(const Vec3& a) { return std::sqrt(a.x * a.x + a.y * a.y + a.z * a.z); }
+
+// Independent membership predicates (long double).
+bool InCyl(const Vec3& p)
+{
+  return SqL(p.x - kCyl.cx) + SqL(p.y - kCyl.cy) <= SqL(kCyl.r) && p.z >= kCyl.z0 &&
+         p.z <= kCyl.z1;
+}
+bool InEll(const Vec3& p)
+{
+  return SqL((p.x - kEll.cx) / kEll.ax) + SqL((p.y - kEll.cy) / kEll.ay) +
+             SqL((p.z - kEll.cz) / kEll.az) <=
+         1.0L;
+}
+bool InZ(const Vec3& p) { return InCyl(p) && InEll(p); }
+
+// Exit parameter of a segment whose start is inside Z and whose end is
+// outside, by plain bisection (Z is convex, so there is one exit).
+double BisectExit(const Vec3& inside, const Vec3& outside)
+{
+  double lo = 0.0, hi = 1.0;
+  for (int i = 0; i < 200; ++i) {
+    const double mid = 0.5 * (lo + hi);
+    if (InZ(Lerp(inside, outside, mid))) lo = mid;
+    else hi = mid;
+  }
+  return 0.5 * (lo + hi);
+}
+
+// The director's exact vertical-length formula, herramientas/
+// validar_volumen_oe1.py:18-25, restricted to points inside both XY
+// projections (as its nested quadrature is).
+double VerticalOracle(double x, double y)
+{
+  if (Sq(x - kCyl.cx) + Sq(y - kCyl.cy) > Sq(kCyl.r)) return 0.0;
+  const double ex = 1.0 - Sq((x - kEll.cx) / kEll.ax);
+  const double inner = ex - Sq((y - kEll.cy) / kEll.ay);
+  if (inner < 0.0) return 0.0;
+  const double half = kEll.az * std::sqrt(inner);
+  return std::max(0.0, std::min(kCyl.z1, kEll.cz + half) - std::max(kCyl.z0, kEll.cz - half));
+}
+
+bool Finite(const CrossingResult& r)
+{
+  const double v[] = {r.lo, r.hi, r.len, r.lenCyl, r.lenEll};
+  for (const double x : v) {
+    if (!std::isfinite(x)) return false;
+  }
+  return true;
+}
+
+// ---------------------------------------------------------------- C1
+void TestC1()
+{
+  const Vec3 a{21.36, -30.71, -10.0}, b{21.36, -30.71, 400.0};
+  const CrossingResult r = Region().Intersect(a, b);
+  CHECK(r.hit);
+  CHECK_NEAR(r.len, 89.67389128531408, kAbsTol);            // plan literal
+  CHECK_NEAR(r.len, VerticalOracle(21.36, -30.71), kAbsTol);  // director formula
+  CHECK(r.bothOut);
+  CHECK(r.deep);
+  CHECK(!r.graze);
+  CHECK(r.lo > 0.0 && r.hi < 1.0);
+  oe1::EntryCounter ec;
+  CHECK(ec.Step(r, Norm(Sub(b, a))));  // one entry
+  // Entry and exit heights against closed forms.
+  const LD ex = 1.0L - SqL((21.36L - kEll.cx) / kEll.ax);
+  const LD half = kEll.az * std::sqrt(ex - SqL((-30.71L - kEll.cy) / kEll.ay));
+  const double zin = static_cast<double>(kEll.cz - half);
+  const double zout = static_cast<double>(kEll.cz + half);
+  CHECK_NEAR(-10.0 + r.lo * 410.0, zin, kAbsTol);
+  CHECK_NEAR(-10.0 + r.hi * 410.0, zout, kAbsTol);
+  CHECK_NEAR(r.lenCyl, 340.0, kAbsTol);
+  CHECK_NEAR(r.lenEll, static_cast<double>(2.0L * half), kAbsTol);
+  // The same line downwards, and a few more vertical lines against the oracle.
+  const CrossingResult rr = Region().Intersect(b, a);
+  CHECK_NEAR(rr.len, r.len, 1e-12);
+  std::mt19937_64 gen(1);
+  std::uniform_real_distribution<double> ux(-1.0, 42.0), uy(-46.0, -12.0);
+  for (int i = 0; i < 20000; ++i) {
+    const double x = ux(gen), y = uy(gen);
+    const CrossingResult q = Region().Intersect({x, y, -50.0}, {x, y, 500.0});
+    CHECK_NEAR(q.len, VerticalOracle(x, y), kAbsTol);
+  }
+}
+
+// ---------------------------------------------------------------- C2
+void TestC2()
+{
+  const double y = -30.71, z = 137.81;
+  const Vec3 a{-100.0, y, z}, b{150.0, y, z};
+  const CrossingResult r = Region().Intersect(a, b);
+  const LD hc = std::sqrt(SqL(kCyl.r) - SqL(static_cast<LD>(y) - kCyl.cy));
+  const double xin = static_cast<double>(kCyl.cx - hc), xout = static_cast<double>(kCyl.cx + hc);
+  CHECK(r.hit && r.deep && r.bothOut);
+  CHECK_NEAR(r.len, xout - xin, kAbsTol);
+  CHECK_NEAR(r.len, 40.12161013718168, kAbsTol);  // design value
+  CHECK_NEAR(-100.0 + r.lo * 250.0, xin, kAbsTol);
+  CHECK_NEAR(-100.0 + r.hi * 250.0, xout, kAbsTol);
+  CHECK_NEAR(-100.0 + r.lo * 250.0, 0.23919493140915904, kAbsTol);
+  CHECK_NEAR(-100.0 + r.hi * 250.0, 40.36080506859084, kAbsTol);
+  // Along y through the centroid, and along z (already C1).
+  const double x = 21.36;
+  const CrossingResult ry = Region().Intersect({x, -120.0, z}, {x, 20.0, z});
+  const LD hcy = std::sqrt(SqL(kCyl.r) - SqL(static_cast<LD>(x) - kCyl.cx));
+  const LD hey = kEll.ay * std::sqrt(1.0L - SqL((x - kEll.cx) / kEll.ax) -
+                                 SqL((static_cast<LD>(z) - kEll.cz) / kEll.az));
+  const LD ylo = std::max(kCyl.cy - hcy, kEll.cy - hey);
+  const LD yhi = std::min(kCyl.cy + hcy, kEll.cy + hey);
+  CHECK_NEAR(ry.len, static_cast<double>(yhi - ylo), kAbsTol);
+}
+
+// ---------------------------------------------------------------- C3
+// Line along y at x = 41.3 - delta, z = 137.8: tangent to the conduit; its
+// chord in the conduit lies inside the ellipsoid.
+struct TangentCase {
+  double delta;
+  bool hit, deep, graze;
+};
+
+void TestC3()
+{
+  const TangentCase cases[] = {{1e-3, true, true, false},
+                               {1e-7, true, false, true},
+                               {-1e-7, false, false, true},
+                               {-1e-3, false, false, false}};
+  for (const TangentCase& c : cases) {
+    const double x = kCyl.cx + kCyl.r - c.delta;
+    const CrossingResult r = Region().Intersect({x, -100.0, 137.8}, {x, 50.0, 137.8});
+    const LD d = c.delta;
+    const double expected = c.delta > 0 ? static_cast<double>(2.0L * std::sqrt(d * (2.0L * kCyl.r - d))) : 0.0;
+    CHECK_NEAR(r.len, expected, kAbsTol);
+    CHECK(r.hit == c.hit);
+    CHECK(r.deep == c.deep);
+    CHECK(r.graze == c.graze);
+    CHECK(Finite(r));
+  }
+  CHECK_NEAR(Region().Intersect({41.299, -100.0, 137.8}, {41.299, 50.0, 137.8}).len,
+             0.40987315110913297, kAbsTol);
+  CHECK_NEAR(Region().Intersect({41.2999999, -100.0, 137.8}, {41.2999999, 50.0, 137.8}).len,
+             0.004098780406609269, kAbsTol);
+
+  // Same for the ellipsoid: line along x at y = -12.5 - delta (its northern
+  // apex), z = 137.8; the apex lies inside the conduit.
+  for (const TangentCase& c : cases) {
+    const double y = kEll.cy + kEll.ay - c.delta;
+    const CrossingResult r = Region().Intersect({-100.0, y, 137.8}, {150.0, y, 137.8});
+    const LD d = c.delta;
+    const LD q = 1.0L - SqL((kEll.ay - d) / kEll.ay);
+    const double expected = c.delta > 0 ? static_cast<double>(2.0L * kEll.ax * std::sqrt(q)) : 0.0;
+    CHECK_NEAR(r.len, expected, kAbsTol);
+    CHECK(r.hit == c.hit);
+    CHECK(r.deep == c.deep);
+    CHECK(r.graze == c.graze);
+  }
+  // A step that only starts on the surface of Z (a navigation boundary in
+  // variant B) is not a graze: chord from a surface point going outwards.
+  const double xs = kCyl.cx + kCyl.r;
+  const CrossingResult edge = Region().Intersect({xs, -24.5, 137.8}, {xs + 5.0, -24.5, 137.8});
+  CHECK(!edge.deep);
+  CHECK(!edge.graze);
+}
+
+// ---------------------------------------------------------------- C4
+void TestC4()
+{
+  const Vec3 a{20.3, -24.5, 260.0}, b{32.2, -120.0, 137.8};
+  const CrossingResult r = Region().Intersect(a, b);
+  CHECK(r.lenCyl > 0.0);
+  CHECK(r.lenEll > 0.0);
+  CHECK(r.len == 0.0);
+  CHECK(!r.deep);
+  CHECK(!r.graze);
+  CHECK(!r.bothOut);
+  // Cross-check both primitive lengths by dense sampling.
+  const int k = 400000;
+  const double chord = Norm(Sub(b, a));
+  int inc = 0, ine = 0, inz = 0;
+  for (int i = 0; i <= k; ++i) {
+    const Vec3 p = Lerp(a, b, static_cast<double>(i) / k);
+    inc += InCyl(p);
+    ine += InEll(p);
+    inz += InZ(p);
+  }
+  CHECK_NEAR(r.lenCyl, chord * inc / k, 2.0 * chord / k);
+  CHECK_NEAR(r.lenEll, chord * ine / k, 2.0 * chord / k);
+  CHECK(inz == 0);
+}
