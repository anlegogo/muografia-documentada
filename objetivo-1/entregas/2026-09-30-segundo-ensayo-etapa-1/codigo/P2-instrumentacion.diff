+     << "  " << prog << " --primaries LIST.csv --primaries-sha256 HEX --roi-mask MASK.txt\n"
+     << "      --roi-mask-sha256 HEX --transport-seed S --variant A|B --case-code K\n"
+     << "      --replica R [--region-pair I,J|none] [--muon-log full|min] --geometry G.json\n"
