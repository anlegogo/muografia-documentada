+#ifndef OE1_TESTS_LIST_SUPPORT_HH
+#define OE1_TESTS_LIST_SUPPORT_HH
+
+// Helpers shared by the standalone tests that need primary lists on disk.
+#include <cmath>
+#include <cstdint>
