+uint64_t CanonicalFnv(const std::vector<PrimaryRecord>& recs)
+{
+  Fnv1a64 h;
+  for (const auto& r : recs) {
+    h.I64(r.id);
+    h.F64(r.x_m);
+    h.F64(r.y_m);
+    h.F64(r.z_m);
+    h.F64(r.dx);
+    h.F64(r.dy);
+    h.F64(r.dz);
+    h.F64(r.ekin_gev);
+    h.I32(r.pdg);
+  }
+  return h.Value();
+}
