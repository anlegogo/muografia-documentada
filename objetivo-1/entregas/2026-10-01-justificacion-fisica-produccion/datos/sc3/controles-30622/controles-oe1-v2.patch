+  // OE1 check C4: extend the elevation rows by the requested margin. Rows
+  // outside the table get weights linearly extrapolated from the eight edge
+  // rows (clipped at zero); elevations below 0.1 deg get no weight.
+  const double margin = ctrl::Get().marginDeg;
+  if (margin > 0.0 && tables != nullptr) {
+    const int n = tables->NumRows();
+    const double step = 2.0 * tables->RowHalfStepDeg();
+    const int extra = static_cast<int>(std::ceil(margin / step));
+    auto edgeFit = [&](int first) {  // least squares on rows [first, first+8)
+      double sx = 0, sy = 0, sxx = 0, sxy = 0;
+      for (int i = first; i < first + 8; ++i) {
+        const double x = tables->RowElevationDeg(i), y = tables->RowWeight(i);
+        sx += x; sy += y; sxx += x * x; sxy += x * y;
+      }
+      const double b = (8 * sxy - sx * sy) / (8 * sxx - sx * sx);
+      return std::make_pair((sy - b * sx) / 8, b);
+    };
+    const auto lo = edgeFit(0);
+    const auto hi = edgeFit(n - 8);
+    double acc = 0.0;
+    for (int k = -extra; k < n + extra; ++k) {
+      const double el = tables->RowElevationDeg(0) + k * step;
+      double w = 0.0;
+      if (k >= 0 && k < n) {
+        w = tables->RowWeight(k);
+      } else if (el >= 0.1) {
+        const auto& fit = k < 0 ? lo : hi;
+        w = std::max(0.0, fit.first + fit.second * el);
+      }
+      acc += w;
+      fExtElevDeg.push_back(el);
+      fExtCumulative.push_back(acc);
+    }
+    for (double& c : fExtCumulative) c /= acc;
+    fExtCumulative.back() = 1.0;
+  }
 }
 
