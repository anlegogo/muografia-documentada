diff -ruN a/scripts/simulation/geant4_app/include/ControlOptions.hh b/scripts/simulation/geant4_app/include/ControlOptions.hh
--- a/scripts/simulation/geant4_app/include/ControlOptions.hh
+++ b/scripts/simulation/geant4_app/include/ControlOptions.hh
@@ -0,0 +1,76 @@
+#ifndef CONTROL_OPTIONS_HH
+#define CONTROL_OPTIONS_HH
+
+// Diagnostic options for the OE1 physical checks C1, C2, C4 and C5.
+// Read once from environment variables. With none of them set, the
+// executable behaves exactly as the production build (same random-number
+// consumption, same histogram, no extra files).
+//   OE1C_PLANE_HALF_M      counting-plane half side in m (default 300)
+//   OE1C_INJECT=edifice    start primaries just outside a cylinder that
+//                          encloses the edifice instead of D + R + 300 m away
+//   OE1C_EDIFICE_MARGIN_M  margin of that cylinder (default 50 m)
+//   OE1C_MARGIN_DEG        extra generation margin around the image window
+//   OE1C_ECUTS_GEV         comma list of kinetic-energy cuts at the plane
+//   OE1C_GEN_HIST=1        write the histogram of nominal directions only
+//   OE1C_SUBPLANES_M       comma list of half sides of nested squares on the
+//                          counting plane (same muons, every energy cut)
+
+#include <cstdlib>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace ctrl {
+
+struct Options {
+  double planeHalfM = 300.0;
+  bool injectAtEdifice = false;
+  double edificeMarginM = 50.0;
+  double marginDeg = 0.0;
+  std::vector<double> ecutsGeV;
+  std::vector<double> subplanesM;
+  bool active = false;
+};
+
+inline const Options& Get()
+{
+  static const Options opts = [] {
+    Options r;
+    auto env = [](const char* key) {
+      const char* v = std::getenv(key);
+      return v != nullptr ? std::string(v) : std::string();
+    };
+    if (const auto s = env("OE1C_PLANE_HALF_M"); !s.empty()) {
+      r.planeHalfM = std::stod(s);
+      r.active = true;
+    }
+    if (env("OE1C_INJECT") == "edifice") {
+      r.injectAtEdifice = true;
+      r.active = true;
+    }
+    if (const auto s = env("OE1C_EDIFICE_MARGIN_M"); !s.empty()) r.edificeMarginM = std::stod(s);
+    if (const auto s = env("OE1C_MARGIN_DEG"); !s.empty()) {
+      r.marginDeg = std::stod(s);
+      r.active = true;
+    }
+    if (const auto s = env("OE1C_ECUTS_GEV"); !s.empty()) {
+      std::stringstream ss(s);
+      std::string tok;
+      while (std::getline(ss, tok, ',')) r.ecutsGeV.push_back(std::stod(tok));
+      r.active = true;
+    }
+    if (const auto s = env("OE1C_SUBPLANES_M"); !s.empty()) {
+      std::stringstream ss(s);
+      std::string tok;
+      while (std::getline(ss, tok, ',')) r.subplanesM.push_back(std::stod(tok));
+      r.active = true;
+    }
+    if (env("OE1C_GEN_HIST") == "1") r.active = true;
+    return r;
+  }();
+  return opts;
+}
+
+}  // namespace ctrl
+
+#endif
